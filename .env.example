# Copy to .env to override. The app boots with safe dev defaults if .env is absent,
# so a reviewer can run it with zero configuration.

# HTTP port for the Hono server (serves /api and, in production, the built client).
PORT=3000

# development | production. Controls the cookie Secure flag and static-file serving.
NODE_ENV=development

# Secret used to sign access JWTs. A random dev secret is generated at boot if unset
# (with a warning). MUST be set explicitly in production.
JWT_SECRET=dev-insecure-change-me

# Shared secret for the mock SAP webhook (sent as the x-webhook-secret header).
SAP_WEBHOOK_SECRET=dev-sap-secret

# Token lifetimes, in seconds. 900 = 15 min access, 604800 = 7 days refresh.
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800

# SQLite file location (relative to project root).
DATABASE_URL=./data/app.sqlite

# Seeded supervisor credentials (used to log in on a fresh database).
SEED_USERNAME=supervisor
SEED_PASSWORD=inspect123
